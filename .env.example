# Primary provider: Groq (free tier) serving open models
GROQ_API_KEY=
GROQ_ASR_LANGUAGE=ur
GROQ_ASR_MODELS=whisper-large-v3,whisper-large-v3-turbo
GROQ_LLM_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b

# Optional backup: any OpenAI-compatible provider serving open models
BACKUP_BASE_URL=
BACKUP_API_KEY=
BACKUP_LLM_MODELS=
BACKUP_ASR_MODELS=

# Optional: ElevenLabs reads the Urdu confirmation aloud (default: premade male voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODELS=eleven_v3,eleven_multilingual_v2

# Random string; keeps logins valid across restarts
SECRET_KEY=
COOKIE_SECURE=1
LIVE_CALLS_PER_HOUR=20
